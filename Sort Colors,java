class Solution {
    public void sortColors(int[] nums) {
        int n = nums.length;
        int cnt0 = 0;
        int cnt1 = 0;
        int cnt2 = 0;
        for(int ele : nums){
            if(ele==0) cnt0++;
            else if(ele==1) cnt1++;
            else cnt2++;
        }
        int i=0;
        while(cnt0-- > 0){
            nums[i++]=0;
        }
        while(cnt1-- > 0){
            nums[i++]=1;
        }
        while(cnt2-- > 0){
            nums[i++]=2;
        }
    }
}